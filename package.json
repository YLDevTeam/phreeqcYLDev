{
  "type": "module",
  "name": "phreeqcYLDev",
  "version": "0.1.0",
  "description": "PHREEQC (IPhreeqc) compilé en WebAssembly pour le navigateur et Node.js",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dist/*": "./dist/*",
    "./dist/database/*": "./dist/database/*"
  },
  "browser": {
    "node:fs/promises": false,
    "node:url": false
  },
  "engines": {"node": ">=18"},
  "files": ["src", "dist", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["phreeqc", "geochemistry", "wasm", "webassembly", "chemistry"],
  "author": "YLDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YLDevTeam/phreeqcYLDev.git"
  },
  "homepage": "https://github.com/YLDevTeam/phreeqcYLDev#readme",
  "bugs": {"url": "https://github.com/YLDevTeam/phreeqcYLDev/issues"},
  "sideEffects": false
}
